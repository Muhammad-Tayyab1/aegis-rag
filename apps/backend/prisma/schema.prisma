generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  member

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  removed

  @@map("user_status")
}

enum DocumentStatus {
  pending
  processing
  ready
  failed

  @@map("document_status")
}

enum IngestionJobStatus {
  pending
  processing
  completed
  failed

  @@map("ingestion_job_status")
}

model Tenant {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String                 @unique
  plan            String                 @default("starter")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  config          TenantConfig?
  users           User[]
  documents       Document[]
  chunks          Chunk[]
  queries         Query[]
  traces          QueryTrace[]
  feedback        Feedback[]
  connectors      Connector[]
  tickets         Ticket[]
  cache           SemanticCache[]
  rateLimitWindow TenantRateLimitWindow?
  billingEvents   BillingEvent[]
  ingestionJobs   IngestionJob[]
  auditEvents     AuditEvent[]
  invitations     Invitation[]

  @@map("tenants")
}

model BillingEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  milestone   Int
  payload     Json
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, milestone])
  @@index([tenantId, createdAt])
  @@map("billing_events")
}

model TenantRateLimitWindow {
  tenantId     String   @id @map("tenant_id") @db.Uuid
  windowStart  DateTime @map("window_start") @db.Timestamptz(6)
  requestCount Int      @map("request_count")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_rate_limit_windows")
}

model TenantConfig {
  tenantId          String   @id @map("tenant_id") @db.Uuid
  chunkSize         Int      @default(800) @map("chunk_size")
  chunkOverlap      Int      @default(100) @map("chunk_overlap")
  embeddingModel    String   @default("aegis-hash-384") @map("embedding_model")
  retrievalStrategy String   @default("hybrid") @map("retrieval_strategy")
  rerankEnabled     Boolean  @default(true) @map("rerank_enabled")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_config")
}

model User {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  email            String       @unique
  passwordHash     String       @map("password_hash")
  refreshTokenHash String?      @map("refresh_token_hash")
  role             UserRole     @default(member)
  status           UserStatus   @default(active)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  queries          Query[]
  auditEvents      AuditEvent[] @relation("AuditActor")
  invitations      Invitation[] @relation("InvitationCreator")

  @@map("users")
}

model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String
  role        UserRole  @default(member)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, email])
  @@map("invitations")
}

model Document {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  sourceType    String         @map("source_type")
  filename      String
  sourceUri     String?        @map("source_uri")
  status        DocumentStatus @default(pending)
  contentHash   String?        @map("content_hash")
  uploadedAt    DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks        Chunk[]
  ingestionJobs IngestionJob[]

  @@map("documents")
}

model IngestionJob {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  documentId  String             @map("document_id") @db.Uuid
  sourceKey   String             @map("source_key")
  content     String
  status      IngestionJobStatus @default(pending)
  attempts    Int                @default(0)
  maxAttempts Int                @default(3) @map("max_attempts")
  availableAt DateTime           @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt    DateTime?          @map("locked_at") @db.Timestamptz(6)
  lastError   String?            @map("last_error")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document    Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([tenantId, documentId])
  @@map("ingestion_jobs")
}

model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorEmail   String?  @map("actor_email")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  result       String
  ipAddress    String?  @map("ip_address")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@map("audit_events")
}

model Chunk {
  id         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String                      @map("document_id") @db.Uuid
  tenantId   String                      @map("tenant_id") @db.Uuid
  ordinal    Int
  content    String
  embedding  Unsupported("vector(384)")?
  metadata   Json                        @default("{}")
  createdAt  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenant     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  traces     QueryTrace[]

  @@unique([documentId, ordinal])
  @@index([tenantId, documentId])
  @@map("chunks")
}

model Query {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  question         String
  answer           String?
  tokensUsed       Int          @default(0) @map("tokens_used")
  estimatedCostUsd Decimal      @default(0) @map("estimated_cost_usd") @db.Decimal(12, 6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  traces           QueryTrace[]
  feedback         Feedback?

  @@index([tenantId, createdAt])
  @@map("queries")
}

model QueryTrace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryId   String   @map("query_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  stage     String
  sequence  Int      @default(0)
  chunkId   String?  @map("chunk_id") @db.Uuid
  rank      Int?
  score     Decimal? @db.Decimal
  latencyMs Int      @default(0) @map("latency_ms")
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  query     Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunk     Chunk?   @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([queryId, createdAt])
  @@index([queryId, sequence, rank])
  @@map("query_traces")
}

model Feedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryId   String   @unique @map("query_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  rating    Int
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  query     Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model Connector {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String
  type         String
  config       Json
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("connectors")
}

model Ticket {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  queryId   String?  @map("query_id") @db.Uuid
  summary   String
  priority  String
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("tickets")
}

model SemanticCache {
  id        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String                      @map("tenant_id") @db.Uuid
  question  String
  answer    String
  citations Json                        @default("[]")
  embedding Unsupported("vector(384)")?
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime                    @map("expires_at") @db.Timestamptz(6)
  tenant    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("semantic_cache")
}
